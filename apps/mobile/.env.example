# The Supabase project that receives the contributions (Project Settings ›
# API Keys). Copy this file to .env and fill it: .env stays out of git.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key (sb_publishable_…) or the anon key: never the secret key.
EXPO_PUBLIC_SUPABASE_KEY=
